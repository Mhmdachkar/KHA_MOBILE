# --- Email (existing) ---
RESEND_API_KEY=
ADMIN_EMAIL=
RESEND_FROM=onboarding@resend.dev
PORT=3001

# --- Postgres catalog + admin auth ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kha_mobile
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated browser origins allowed to call this API (CORS).
# Include every URL where the storefront runs (local + production), e.g.:
# FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173,https://khamobile.store
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173,https://khamobile.store

# Canonical public storefront URL (no trailing slash). Same host should appear in FRONTEND_ORIGIN.
SITE_URL=https://khamobile.store

# Public base URL for uploaded files (used in product image URLs)
API_PUBLIC_URL=http://localhost:3001
