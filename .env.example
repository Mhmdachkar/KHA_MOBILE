# Vite: backend base URL (Express on port 3001 by default)
VITE_API_URL=https://kha-mobile.onrender.com  # or http://localhost:3001 for local dev

# Public storefront URL (no trailing slash). Admin login links and “View store” use this.
# Production example: https://khamobile.store — must match an entry in server FRONTEND_ORIGIN for CORS.
# Local-only: http://localhost:8080
VITE_SITE_URL=https://khamobile.store

# Supabase (optional — only needed if you use @supabase/supabase-js in the frontend)
# Project URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
