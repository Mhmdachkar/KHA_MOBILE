# Vite: backend base URL (Express).
# Local dev (recommended): leave unset — Vite proxies /api and /uploads to :3001 (run `npm run dev:server`).
# Local dev (direct):  VITE_API_URL=http://localhost:3001
# Production API:      VITE_API_URL=https://your-api.onrender.com
#
# VITE_API_URL=

# VITE_API_URL=http://localhost:3001

# Public storefront URL (no trailing slash). Admin “View store” and links use this.
# Local: http://localhost:8080  |  Production: https://khamobile.store
VITE_SITE_URL=http://localhost:8080

# Supabase (optional — only needed if you use @supabase/supabase-js in the frontend)
# Project URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
