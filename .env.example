# Vite: backend base URL (Express). For local dev use your machine so the browser is same-origin with CORS:
#   VITE_API_URL=http://localhost:3001
# To hit a deployed API from localhost, the server must allow your origin (Render: redeploy after
# server/index.js merges localhost ports into CORS, or set FRONTEND_ORIGIN to include http://localhost:8080).
# VITE_API_URL=https://kha-mobile.onrender.com

VITE_API_URL=http://localhost:3001

# Public storefront URL (no trailing slash). Admin “View store” and links use this.
# Local: http://localhost:8080  |  Production: https://khamobile.store
VITE_SITE_URL=http://localhost:8080

# Supabase (optional — only needed if you use @supabase/supabase-js in the frontend)
# Project URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
